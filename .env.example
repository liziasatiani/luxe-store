# ============================================================
# EVERYTHING STREET — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://everythingstreet.com
NEXT_PUBLIC_APP_NAME="Everything Street"
NODE_ENV=production

# ─── Database (Supabase PostgreSQL) ─────────────────────────
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]
SUPABASE_STORAGE_BUCKET=products

# ─── NextAuth ────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=[YOUR-NEXTAUTH-SECRET]
NEXTAUTH_URL=https://everythingstreet.com

# ─── OAuth Providers (optional) ──────────────────────────────
GOOGLE_CLIENT_ID=[YOUR-GOOGLE-CLIENT-ID]
GOOGLE_CLIENT_SECRET=[YOUR-GOOGLE-CLIENT-SECRET]

# ─── Stripe ──────────────────────────────────────────────────
# Set NEXT_PUBLIC_STRIPE_ENABLED=false to disable Stripe entirely
NEXT_PUBLIC_STRIPE_ENABLED=false
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_[YOUR-STRIPE-PUBLISHABLE-KEY]
STRIPE_SECRET_KEY=sk_live_[YOUR-STRIPE-SECRET-KEY]
STRIPE_WEBHOOK_SECRET=whsec_[YOUR-STRIPE-WEBHOOK-SECRET]
STRIPE_CURRENCY=usd

# ─── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=[YOUR-RESEND-API-KEY]
EMAIL_FROM="Everything Street <noreply@everythingstreet.com>"
# Optional: where contact form submissions are delivered
CONTACT_EMAIL=hello@everythingstreet.com

# ─── Cron Jobs ───────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Pass as x-cron-secret header when calling /api/cron/* endpoints
CRON_SECRET=[YOUR-CRON-SECRET]

# ─── Social / Contact ────────────────────────────────────────
# Leave blank to hide from contact page / footer
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_CONTACT_MAPS_URL=
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/everythingstreet
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/everythingstreet
NEXT_PUBLIC_MESSENGER_URL=https://m.me/everythingstreet

# ─── Analytics ───────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ─── Seed Passwords (used only by npx prisma db seed) ────────
# Override defaults before seeding a production DB
SEED_ADMIN_PASSWORD=[STRONG-ADMIN-PASSWORD]
SEED_DEMO_PASSWORD=[STRONG-DEMO-PASSWORD]

# ─── Rate Limiting ───────────────────────────────────────────
# Optional but strongly recommended in production
UPSTASH_REDIS_REST_URL=[YOUR-UPSTASH-URL]
UPSTASH_REDIS_REST_TOKEN=[YOUR-UPSTASH-TOKEN]
